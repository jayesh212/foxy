{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://foxy.example/schema/case.schema.json",
  "title": "Foxy case file",
  "description": "One Foxy case booklet: the facts a player reads, the workbook questions they answer, Mr. Foxy's hints, and the answer key. Files live in cases/<tier>/NN-slug.json.",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "number", "slug", "title", "tier", "difficulty", "minutes", "tagline", "setting", "briefing", "suspects", "evidence", "questions", "hints", "solution", "playtest"],
  "properties": {
    "$schema": { "type": "string" },
    "id": { "type": "string", "pattern": "^case-[0-9]{2}$", "description": "Stable id, e.g. case-07. Never reuse a retired id." },
    "number": { "type": "integer", "minimum": 1 },
    "slug": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$" },
    "title": { "type": "string", "maxLength": 60 },
    "tier": { "enum": ["easy", "medium", "hard"] },
    "difficulty": { "type": "integer", "minimum": 1, "maximum": 5, "description": "Dots shown on the case card. Easy 1-2, medium 2-3, hard 4-5." },
    "minutes": { "type": "integer", "minimum": 5, "description": "Typical solve time from playtesting." },
    "tagline": { "type": "string", "maxLength": 200, "description": "One-line hook for the case card. No spoilers." },
    "crime": { "type": "string", "description": "theft, sabotage, forgery, fraud, poisoning, murder, disappearance..." },
    "tags": { "type": "array", "items": { "type": "string" }, "description": "Mechanics used, e.g. timeline, cipher, logic, alibi." },
    "setting": {
      "type": "object",
      "additionalProperties": false,
      "required": ["place", "when"],
      "properties": {
        "place": { "type": "string" },
        "when": { "type": "string" }
      }
    },
    "briefing": { "type": "array", "items": { "type": "string" }, "minItems": 1, "description": "Opening pages of the booklet, one paragraph per item." },
    "rules": { "type": "array", "items": { "type": "string" }, "description": "Ground rules the player may rely on (e.g. 'innocent people tell the truth'). Anything the solution depends on that is not physical evidence must be stated here." },
    "suspects": {
      "type": "array",
      "minItems": 3,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "name", "role", "description", "statement"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
          "name": { "type": "string" },
          "role": { "type": "string" },
          "description": { "type": "string" },
          "motive": { "type": "string" },
          "statement": { "type": "string", "description": "What the suspect told the detective, in their own words." }
        }
      }
    },
    "evidence": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "kind", "title", "body"],
        "properties": {
          "id": { "type": "string", "pattern": "^ev[0-9]+$" },
          "kind": { "enum": ["statement", "document", "object", "photo", "log", "map", "report", "letter", "transcript", "timetable", "note"] },
          "title": { "type": "string" },
          "source": { "type": "string" },
          "body": { "type": "array", "items": { "type": "string" }, "description": "Paragraphs or lines, shown in order." },
          "table": {
            "type": "object",
            "additionalProperties": false,
            "required": ["columns", "rows"],
            "properties": {
              "columns": { "type": "array", "items": { "type": "string" } },
              "rows": { "type": "array", "items": { "type": "array", "items": { "type": "string" } } }
            }
          }
        }
      }
    },
    "questions": {
      "type": "array",
      "minItems": 3,
      "description": "Workbook questions, in the order the player meets them. The last one must be the accusation.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "prompt", "kind", "answer", "explanation", "evidence"],
        "properties": {
          "id": { "type": "string", "pattern": "^q[0-9]+$" },
          "prompt": { "type": "string" },
          "kind": { "enum": ["suspect", "choice", "time", "number", "text"], "description": "suspect: answer is a suspect id. choice: answer is an option id. time: HH:MM 24h. number: a numeral. text: graded against accept[]." },
          "options": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["id", "text"],
              "properties": { "id": { "type": "string" }, "text": { "type": "string" } }
            }
          },
          "answer": { "type": "string" },
          "accept": { "type": "array", "items": { "type": "string" }, "description": "Other accepted answers (text/number/time kinds). Compared lower-case, trimmed." },
          "explanation": { "type": "string", "description": "Shown after answering. Explains why, citing evidence." },
          "evidence": { "type": "array", "items": { "type": "string" }, "description": "Evidence ids that prove the answer." }
        }
      }
    },
    "hints": {
      "type": "array",
      "description": "Mr. Foxy's hints. Every question gets level 1 (nudge: where to look), level 2 (pointer: what to compare) and level 3 (strong: the deduction, one step short of the answer).",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["question", "level", "text"],
        "properties": {
          "question": { "type": "string" },
          "level": { "type": "integer", "minimum": 1, "maximum": 3 },
          "text": { "type": "string" }
        }
      }
    },
    "solution": {
      "type": "object",
      "additionalProperties": false,
      "required": ["culprit", "summary", "chain"],
      "properties": {
        "culprit": { "type": "string", "description": "Suspect id." },
        "summary": { "type": "string", "description": "The reveal, as Mr. Foxy tells it when the case is closed." },
        "chain": {
          "type": "array",
          "minItems": 2,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["step", "evidence"],
            "properties": {
              "step": { "type": "string" },
              "evidence": { "type": "array", "items": { "type": "string" } }
            }
          }
        },
        "eliminations": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["suspect", "why"],
            "properties": { "suspect": { "type": "string" }, "why": { "type": "string" } }
          }
        }
      }
    },
    "playtest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["solvePath", "pitfalls", "revisions"],
      "properties": {
        "solvePath": { "type": "string", "description": "How a first-time human solver actually gets there." },
        "pitfalls": { "type": "array", "items": { "type": "string" }, "description": "Where playtesters went wrong, and what now stops it." },
        "revisions": { "type": "array", "items": { "type": "string" }, "description": "Changes made after playtesting to make the case fair and unambiguous." },
        "verifier": { "type": "string", "description": "Path to a script that brute-forces uniqueness, for logic-heavy cases." }
      }
    }
  }
}
